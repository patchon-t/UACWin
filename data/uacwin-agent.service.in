[Unit]
Description=UACWin - Windows-style polkit authentication agent
PartOf=graphical-session.target
After=graphical-session.target
Conflicts=plasma-polkit-agent.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=@UACWIN_EXEC@
Restart=on-failure
RestartSec=2
Slice=session.slice
TimeoutStopSec=5sec

[Install]
WantedBy=graphical-session.target
